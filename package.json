{
  "name": "aik-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:connected": "vite --mode server --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b && vite build --mode server",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/api.test.mjs tests/cloudflare.worker.test.mjs tests/cloudflare.enable.test.mjs",
    "test:cloudflare": "node --test tests/cloudflare.runtime.test.mjs",
    "cf:dev": "wrangler dev --local",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:check": "wrangler deploy --dry-run",
    "cf:deploy": "node --use-env-proxy --use-system-ca scripts/cloudflare-deploy.mjs",
    "cf:enable": "node --use-env-proxy --use-system-ca scripts/cloudflare-enable.mjs",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test --config playwright.server.config.ts",
    "telegram:configure": "node --env-file-if-exists=.env scripts/configure-telegram.mjs",
    "build:sites-bot": "vite build --config sites/vite.config.mjs",
    "test:sites-bot": "npm run build:sites-bot && node --test tests/sites.bot.test.mjs tests/sites.connect.test.mjs",
    "sites:connect": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env scripts/connect-sites-bot.mjs",
    "test:e2e:studio": "playwright test --config playwright.studio.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  }
}
