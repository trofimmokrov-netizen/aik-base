# Frontend: empty = local same-origin API. For Pages set your HTTPS backend URL.
VITE_API_URL=

# Backend (Node 24). Keep database on a persistent volume.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/aik-base.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Set only when there is exactly one trusted reverse proxy in front of Node.
TRUST_PROXY_HOPS=0

# Enter these securely on your backend host, never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=https://trofimmokrov-netizen.github.io/aik-base/
PUBLIC_API_URL=

# Optional contact info, exposed publicly by /api/config.
CONTACT_PHONE=
CONTACT_EMAIL=
